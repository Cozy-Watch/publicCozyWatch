{
  "name": "cozywatch",
  "productName": "CozyWatch",
  "version": "0.9.6",
  "packageManager": "npm@10.9.8",
  "description": "Github notification",
  "main": ".vite/build/main.js",
  "author": {
    "name": "Tiago Sá",
    "email": "tiago@cozywatch.com"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin",
    "make:mac:official": "COZYWATCH_OFFICIAL_BUILD=true electron-forge make --platform=darwin --arch=universal",
    "publish:mac": "COZYWATCH_OFFICIAL_BUILD=true electron-forge publish --platform=darwin --arch=universal",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "test": "jest --no-watchman",
    "test:refresh": "jest --config jest.refresh.config.cjs --no-watchman --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cozy-Watch/CozyWatch"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/dompurify": "^3.0.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^44.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.12.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "keywords": [],
  "license": "MIT",
  "overrides": {
    "@octokit/core": "^7.0.6"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@octokit/auth-oauth-device": "^8.0.5",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@primer/octicons-react": "^19.28.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "marked": "^18.0.5",
    "menubar": "^9.5.2",
    "motion": "^12.40.0",
    "p-limit": "^7.3.2",
    "react": "^19.2.7",
    "react-confetti": "^6.4.0",
